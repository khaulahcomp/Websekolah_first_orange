# Folder upload: tidak boleh ada eksekusi script (cegah webshell)
<FilesMatch "\.(php[0-9]?|phtml|pht|phar|shtml|cgi|pl|py|sh|asp|aspx|jsp)$">
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
