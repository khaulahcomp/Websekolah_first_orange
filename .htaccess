RewriteOptions inherit

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Paksa HTTPS (aman di balik Cloudflare/proxy). Hapus blok 6 baris ini bila SSL belum aktif.
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
	RewriteCond %{HTTP:CF-Visitor} !https [NC]
	RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
	RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Blokir file sensitif agar tidak bisa diunduh lewat browser (termasuk database SQLite)
<FilesMatch "(^\.|\.(sql|sqlite|sqlite3|db|log|bak|old|orig|ini|sh|md|rst|lock|dist|swp)$|^error_log$|^composer\.|^license\.txt$)">
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
</FilesMatch>

# Hanya index.php yang boleh dijalankan langsung. File PHP lain (mis. webshell yang terselip) ditolak.
<FilesMatch "^(?!index\.php$).+\.(php[0-9]?|phtml|pht|phar)$">
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
</FilesMatch>

# Hanya metode GET, POST, HEAD
<IfModule mod_authz_core.c>
  <LimitExcept GET POST HEAD>
    Require all denied
  </LimitExcept>
</IfModule>

<Files 403.shtml>
order allow,deny
allow from all
</Files>

<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
	# Bagian aman dari CSP yang diberlakukan. Kebijakan penuh (report-only) dikirim oleh aplikasi.
	Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
	Header always unset X-Powered-By
	Header unset X-Powered-By
</IfModule>
